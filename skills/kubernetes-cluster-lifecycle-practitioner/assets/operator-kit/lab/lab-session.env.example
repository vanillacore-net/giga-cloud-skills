# Copy this file to lab-session.env and review every value once.
# Source it only from the chapter-4/lab directory.
LAB_ROOT="$(pwd -P)"
OS_CLOUD="REPLACE_WITH_PROFILE_NAME"
OS_CLIENT_CONFIG_FILE="REPLACE_WITH_PROTECTED_CLOUDS_YAML_PATH"
KUBECONFIG="$LAB_ROOT/foundation/ansible/management.kubeconfig"
MANAGEMENT_CONTEXT="kubernetes-admin@kubernetes"
SERVICE_A_KUBECONFIG="$LAB_ROOT/service-a.kubeconfig"
SERVICE_A_CONTEXT="service-a-admin@service-a"
LOADBALANCER_KUBECONFIG="$LAB_ROOT/loadbalancer.kubeconfig"
LOADBALANCER_CONTEXT="loadbalancer-admin@loadbalancer"
CONFIG_REPO="$LAB_ROOT/operator-config"
CONFIG_REPO_URL="https://git.example.org/platform/config.git"
CONFIG_REPO_REVISION="main"
